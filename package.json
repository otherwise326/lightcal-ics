{
  "name": "lightcal-ics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:g0 && npm run generate:pwa-icons && vite build",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name lightcal-ics --branch main",
    "deploy:worker": "wrangler deploy",
    "test": "node --test",
    "generate:g0": "node scripts/generate-g0-fixture.js",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.js"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  }
}
